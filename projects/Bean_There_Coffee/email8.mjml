<mjml>
  <mj-head>
    <mj-font
      name="Fredoka"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
    />
    <mj-attributes>
      <mj-all
        font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
      />
      <mj-text line-height="1.5" />
    </mj-attributes>
    <mj-style>
      * { box-sizing: border-box; } .vip-pill { background-color: #27332A;
      text-transform: uppercase; border: 1px solid #D4A373; padding: 6px 16px;
      border-radius: 20px; letter-spacing: 2px; font-weight: 600; font-family:
      'Fredoka', sans-serif; display: inline-block; color: #D4A373; font-size:
      11px; } .personality-card { background: linear-gradient(180deg, #25372A
      0%, #1A2820 100%); border-radius: 20px; border: 1px solid rgba(212, 163,
      115, 0.35); padding: 24px 16px; } .reward-card { background:
      linear-gradient(135deg, #2A3D2F 0%, #1E2D23 100%); border-radius: 20px;
      border: 1.5px dashed #D4A373; padding: 28px 20px; } .voucher-code {
      background-color: #16221B; border: 1px solid #D4A373; border-radius: 10px;
      color: #F5EFE7; font-family: 'Fredoka', sans-serif; font-size: 18px;
      font-weight: 700; letter-spacing: 3px; padding: 12px 24px; display:
      inline-block; } .share-story-card { border-radius: 24px; background:
      linear-gradient(180deg, #25382B 0%, #19271E 100%); border: 2px solid
      #D4A373; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45); } .qr-container {
      background-color: #F5EFE7; border-radius: 14px; padding: 10px; display:
      inline-block; } .chubby-title { font-family: 'Fredoka', sans-serif
      !important; font-weight: 700 !important; line-height: 1.05 !important;
      text-transform: uppercase !important; letter-spacing: -0.5px !important; }
      .photo-round img { border-radius: 16px !important; } .serif-quote {
      font-family: 'Playfair Display', Georgia, serif; font-style: italic; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0E1612">
    <!-- Hero Section -->
    <!-- Previous Unsplash URL: https://images.unsplash.com/photo-1591199763187-9eefb3b8d2b9?auto=format&fit=crop&w=1000&h=800&q=80 -->
    <mj-hero
      mode="fixed-height"
      height="330px"
      background-width="600px"
      background-height="330px"
      background-url="Assets/hero_hot2.png"
      background-color="#1C2B22"
      padding="15px 24px 30px 24px"
    >
      <mj-text
        align="center"
        color="#F5EFE7"
        font-weight="700"
        letter-spacing="3px"
        font-size="26px"
        font-family="'Fredoka', sans-serif"
        padding="0 0 10px 0"
        padding-bottom="70px"
        >⋆☕︎⋆ BEAN THERE</mj-text
      >

      <mj-text
        padding="0 0 6px 0"
        color="#F5EFE7"
        align="left"
        font-family="'Fredoka', sans-serif"
        font-size="64px"
        line-height="1.0"
        font-weight="900"
        >Olivia's
      </mj-text>
      <mj-text
        color="#D4A373"
        font-family="'Fredoka', sans-serif"
        font-size="28px"
        font-weight="600"
        padding="0 0 16px 0"
        >2026 in Coffee ☕</mj-text
      >
    </mj-hero>

    <!-- Warm Introduction & Headline Numbers -->
    <mj-section
      border-top="1px solid rgba(212, 163, 115, 0.2)"
      background-color="#1C2B22"
      padding="20px 28px 20px 28px"
    >
      <mj-column width="100%">
        <mj-text
          align="left"
          font-family="'Playfair Display', Georgia, serif"
          font-size="24px"
          font-weight="700"
          color="#F5EFE7"
          padding="0 0 10px 0"
        >
          Hey Olivia,
        </mj-text>
        <mj-text
          align="left"
          font-size="15px"
          line-height="1.7"
          color="#D2DBD5"
          padding="0 0 20px 0"
        >
          You made every single cup count this year. From brisk dawn extractions
          to restorative afternoon resets, here is the official recap of the
          flavors, rituals, and milestones that fueled your 2026.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Big Number Highlight Card -->
    <mj-section
      background-color="#1C2B22"
      padding="0 24px 30px 24px"
      id="stats-breakdown"
    >
      <mj-column
        background-color="#223528"
        border-radius="18px"
        border="1px solid rgba(212, 163, 115, 0.3)"
        padding="26px 18px"
      >
        <mj-text
          align="center"
          font-size="11px"
          font-weight="700"
          letter-spacing="2.5px"
          color="#D4A373"
          text-transform="uppercase"
          padding="0 0 6px 0"
        >
          ANNUAL BREW COUNT
        </mj-text>
        <mj-text
          align="center"
          font-size="68px"
          font-weight="900"
          font-family="'Fredoka', sans-serif"
          color="#FFFFFF"
          line-height="1.0"
          padding="0 0 4px 0"
        >
          312
        </mj-text>
        <mj-text
          align="center"
          font-size="13px"
          font-weight="700"
          color="#D4A373"
          letter-spacing="2px"
          text-transform="uppercase"
          padding="0 0 12px 0"
        >
          CUPS OF CRAFT COFFEE ENJOYED
        </mj-text>
        <mj-text
          align="center"
          font-size="14px"
          line-height="1.6"
          color="#F5EFE7"
          padding="0 14px 0 14px"
          css-class="serif-quote"
        >
          "That’s 312 good mornings, afternoon resets, and brighter days."
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 01. CIRCADIAN STATS JOURNEY (TIMELINE STORY) -->
    <mj-section
      background-color="#1C2B22"
      padding="30px 28px 12px 28px"
      border-top="1px solid rgba(212, 163, 115, 0.2)"
    >
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="11px"
          font-weight="700"
          letter-spacing="2.5px"
          color="#D4A373"
          text-transform="uppercase"
          padding="0 0 6px 0"
        >
          CIRCADIAN CADENCE
        </mj-text>
        <mj-text
          align="center"
          font-size="32px"
          color="#FFFFFF"
          css-class="chubby-title"
          padding="0 0 6px 0"
        >
          A Day in Your Coffee Year
        </mj-text>
        <mj-text
          align="center"
          font-size="14px"
          line-height="1.6"
          color="#C2C9C4"
          padding="0 16px 20px 16px"
        >
          How 312 extractions mapped onto your daily rhythms and seasonal
          sprints.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- TIMELINE STEP 1: 06:00 AM (PEAK HOUR) -->
    <mj-section background-color="#1C2B22" padding="14px 28px 10px 28px">
      <mj-column width="52%" vertical-align="middle" padding="0 16px 0 0">
        <mj-text padding="0 0 8px 0">
          <span class="vip-pill">06:00 AM</span>
        </mj-text>
        <mj-text
          font-family="'Fredoka', sans-serif"
          font-size="22px"
          font-weight="700"
          color="#FFFFFF"
          padding="0 0 8px 0"
        >
          The Dawn Extraction
        </mj-text>
        <mj-text
          font-size="13px"
          line-height="1.6"
          color="#C2C9C4"
          padding="0 0 10px 0"
        >
          While the rest of the world was hitting snooze, your first espresso
          extraction was already filling the air. Quiet focus before the day
          took off.
        </mj-text>
        <mj-text
          font-size="11px"
          font-weight="700"
          color="#D4A373"
          letter-spacing="0.5px"
          padding="4px 0 0 0"
        >
          ⏰ 6:00 AM · Your most loyal peak hour
        </mj-text>
      </mj-column>

      <mj-column width="48%" vertical-align="middle">
        <mj-image
          src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&h=450&q=80"
          alt="Fresh espresso extraction"
          css-class="photo-round"
          padding="6px 0"
        />
      </mj-column>
    </mj-section>

    <!-- CONNECTOR ARROW 1 -> 2 -->
    <mj-section background-color="#1C2B22" padding="4px 28px">
      <mj-column>
        <mj-text
          align="center"
          font-size="18px"
          font-weight="800"
          color="#D4A373"
          letter-spacing="4px"
        >
          · · · ⇣ · · ·
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- TIMELINE STEP 2: OAT FLAT WHITE -->
    <mj-section background-color="#1C2B22" padding="10px 28px 10px 28px">
      <mj-column width="48%" vertical-align="middle">
        <mj-image
          src="https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=600&h=450&q=80"
          alt="Artisanal silky Oat Flat White"
          css-class="photo-round"
          padding="6px 0"
        />
      </mj-column>

      <mj-column width="52%" vertical-align="middle" padding="0 0 0 16px">
        <mj-text padding="0 0 8px 0">
          <span class="vip-pill">OAT FLAT WHITE</span>
        </mj-text>
        <mj-text
          font-family="'Fredoka', sans-serif"
          font-size="22px"
          font-weight="700"
          color="#FFFFFF"
          padding="0 0 8px 0"
        >
          "Silky &amp; Iconic"
        </mj-text>
        <mj-text
          font-size="13px"
          line-height="1.6"
          color="#C2C9C4"
          padding="0 0 10px 0"
        >
          Your undisputed daily signature. Double ristretto folded into velvety
          oat microfoam—warm, balanced, and effortlessly dialed in.
        </mj-text>
        <mj-text
          font-size="11px"
          font-weight="700"
          color="#D4A373"
          letter-spacing="0.5px"
          padding="4px 0 0 0"
        >
          ☕ #1 Most Ordered Drink (196 orders)
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CONNECTOR ARROW 2 -> 3 -->
    <mj-section background-color="#1C2B22" padding="4px 28px">
      <mj-column>
        <mj-text
          align="center"
          font-size="18px"
          font-weight="800"
          color="#D4A373"
          letter-spacing="4px"
        >
          · · · ⇣ · · ·
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- TIMELINE STEP 3: JULY SPRINT -->
    <mj-section background-color="#1C2B22" padding="10px 28px 28px 28px">
      <mj-column width="52%" vertical-align="middle" padding="0 16px 0 0">
        <mj-text padding="0 0 8px 0">
          <span class="vip-pill">JULY SPRINT</span>
        </mj-text>
        <mj-text
          font-family="'Fredoka', sans-serif"
          font-size="22px"
          font-weight="700"
          color="#FFFFFF"
          padding="0 0 8px 0"
        >
          Mid-Year Peak Season
        </mj-text>
        <mj-text
          font-size="13px"
          line-height="1.6"
          color="#C2C9C4"
          padding="0 0 10px 0"
        >
          Cold brews and extra shots pushed July to your highest coffee volume
          of the whole year, placing you firmly among our top roastery
          loyalists.
        </mj-text>
        <mj-text
          font-size="11px"
          font-weight="700"
          color="#D4A373"
          letter-spacing="0.5px"
          padding="4px 0 0 0"
        >
          ⚡ Top 4% Nationwide · Gold Tier Member
        </mj-text>
      </mj-column>

      <mj-column width="48%" vertical-align="middle">
        <mj-image
          src="https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&h=450&q=80"
          alt="Fresh roasted beans"
          css-class="photo-round"
          padding="6px 0"
        />
      </mj-column>
    </mj-section>

    <!-- PLAYFUL LIFESTYLE CALLOUT BANNER -->
    <mj-section
      background-color="#17261E"
      padding="22px 24px"
      border-top="1px solid rgba(212, 163, 115, 0.2)"
      border-bottom="1px solid rgba(212, 163, 115, 0.2)"
    >
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="18px"
          color="#F5EFE7"
          line-height="1.5"
          css-class="serif-quote"
          padding="0"
        >
          ☕ "At this point, coffee isn't just your daily routine — it's an art
          form."
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 02. MERGED PERSONALITY & FULL STATS DASHBOARD -->
    <mj-section background-color="#1C2B22" padding="34px 24px 30px 24px">
      <mj-column css-class="personality-card" padding="28px 16px">
        <mj-text
          align="center"
          color="#D4A373"
          letter-spacing="2.5px"
          font-weight="700"
          font-size="11px"
          text-transform="uppercase"
          padding="0 0 8px 0"
          >YOUR 2026 ARCHETYPE</mj-text
        >
        <mj-text
          color="#F5EFE7"
          align="center"
          text-transform="uppercase"
          font-family="'Fredoka', sans-serif"
          font-weight="700"
          font-size="34px"
          line-height="1.1"
          padding="0 0 10px 0"
          >⋆ CREAMY CONNOISSEUR ⋆</mj-text
        >
        <mj-text
          color="#C2C9C4"
          align="center"
          font-size="14px"
          line-height="1.6"
          padding="0 18px 24px 18px"
        >
          Crafted from 312 silky extractions, consistent 6:00 AM rituals, and
          unwavering Oat Flat White devotion. Comfort, elevated into true cafe
          craft.
        </mj-text>

        <!-- Nested Stats Grid: Row 1 (3-Col) -->
        <mj-table padding="0 8px 10px 8px">
          <tr>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/clock.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Clock"
                />
                <div
                  style="
                    font-size: 22px;
                    color: #f5efe7;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  6 AM
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  PEAK HOUR
                </div>
              </div>
            </td>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/calendar.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Calendar"
                />
                <div
                  style="
                    font-size: 22px;
                    color: #d4a373;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  JULY
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  TOP MONTH
                </div>
              </div>
            </td>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/like--v1.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Points"
                />
                <div
                  style="
                    font-size: 22px;
                    color: #f5efe7;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  3,120
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  POINTS EARNED
                </div>
              </div>
            </td>
          </tr>
        </mj-table>

        <!-- Nested Stats Grid: Row 2 (3-Col with Loyalty Tier) -->
        <mj-table padding="0 8px">
          <tr>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/crown.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Tier"
                />
                <div
                  style="
                    font-size: 19px;
                    color: #d4a373;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  GOLD
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  CLUB TIER
                </div>
              </div>
            </td>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/guarantee--v1.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Member"
                />
                <div
                  style="
                    font-size: 19px;
                    color: #f5efe7;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  2021
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  MEMBER SINCE
                </div>
              </div>
            </td>
            <td style="width: 33.33%; padding: 4px">
              <div
                style="
                  background: linear-gradient(180deg, #1d2d23 0%, #141f18 100%);
                  border: 1px solid rgba(212, 163, 115, 0.25);
                  border-radius: 14px;
                  padding: 14px 6px;
                  text-align: center;
                "
              >
                <img
                  src="https://img.icons8.com/material-rounded/48/D4A373/trophy.png"
                  width="20"
                  height="20"
                  style="display: block; margin: 0 auto 6px auto"
                  alt="Rank"
                />
                <div
                  style="
                    font-size: 19px;
                    color: #d4a373;
                    font-weight: 700;
                    font-family: 'Fredoka', sans-serif;
                    line-height: 1.1;
                  "
                >
                  TOP 4%
                </div>
                <div
                  style="
                    font-size: 9px;
                    color: #8b967e;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-top: 5px;
                  "
                >
                  NATIONAL RANK
                </div>
              </div>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- 03. TOP 3 DRINKS PODIUM SECTION -->
    <mj-section
      background-color="#1C2B22"
      padding="30px 20px 10px 20px"
      border-top="1px solid rgba(212, 163, 115, 0.2)"
    >
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="11px"
          font-weight="700"
          letter-spacing="2.5px"
          color="#D4A373"
          text-transform="uppercase"
          padding="0 0 6px 0"
        >
          SIPS OF THE YEAR
        </mj-text>
        <mj-text
          align="center"
          font-size="32px"
          color="#FFFFFF"
          css-class="chubby-title"
          padding="0 0 6px 0"
        >
          Your 2026 Drink Podium
        </mj-text>
        <mj-text
          align="center"
          font-size="14px"
          line-height="1.6"
          color="#C2C9C4"
          padding="0 18px 20px 18px"
        >
          Some orders just hit different. Here are the three brews that defined
          your year.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 3-COLUMNS DRINK PODIUM (CLEAN CONTAINER STYLES WITH BULLETPROOF BORDER-RADIUS) -->
    <mj-section background-color="#1C2B22" padding="0px 14px 36px 14px">
      <!-- Drink #1 (Centerpiece / Gold Highlight) -->
      <mj-column width="33.33%" padding="5px">
        <mj-text padding="0">
          <div
            style="
              background: linear-gradient(180deg, #2a3e30 0%, #1a2820 100%);
              border: 1.5px solid #d4a373;
              border-radius: 16px;
              box-shadow: 0 8px 24px rgba(212, 163, 115, 0.15);
              padding: 16px 10px;
              text-align: center;
              box-sizing: border-box;
            "
          >
            <div
              style="
                background: linear-gradient(135deg, #d4a373 0%, #b38250 100%);
                color: #101712;
                font-family: 'Fredoka', sans-serif;
                font-size: 11px;
                font-weight: 700;
                padding: 4px 12px;
                border-radius: 20px;
                display: inline-block;
                letter-spacing: 1px;
              "
            >
              🥇 #1 Favourite
            </div>
            <img
              src="https://images.unsplash.com/photo-1577968897966-3d4325b36b61?auto=format&fit=crop&w=300&h=240&q=80"
              width="130"
              height="100"
              style="
                display: block;
                margin: 10px auto 10px auto;
                object-fit: cover;
                border-radius: 10px;
              "
              alt="Oat Flat White"
