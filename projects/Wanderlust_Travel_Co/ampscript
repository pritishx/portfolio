/* --- 3. Lookup Dynamic Destination --- */
SET @DestRows = LookupRows("Destinations", "TravelStyle", @TravelStyle)

IF RowCount(@DestRows) > 0 THEN
    SET @DestRow     = Row(@DestRows, 1)
    SET @Destination = Field(@DestRow, "Destination")
    SET @Country     = Field(@DestRow, "Country")
    SET @Region      = Field(@DestRow, "Region")
    SET @Nights      = Field(@DestRow, "Nights")
    SET @FromPrice   = Field(@DestRow, "FromPrice")
    SET @Tagline     = Field(@DestRow, "Tagline")
    SET @BookURL     = Field(@DestRow, "BookURL")
ELSE
    SET @DestRowsFallback = LookupRows("Destinations", "TravelStyle", "All")
    IF RowCount(@DestRowsFallback) > 0 THEN
    SET @DestRowFallback = Row(@DestRowsFallback, 1)
    SET @Destination     = Field(@DestRowFallback, "Destination")
    SET @Country         = Field(@DestRowFallback, "Country")
    SET @Region          = Field(@DestRowFallback, "Region")
    SET @Nights          = Field(@DestRowFallback, "Nights")
    SET @FromPrice       = Field(@DestRowFallback, "FromPrice")
    SET @Tagline         = Field(@DestRowFallback, "Tagline")
    SET @BookURL         = Field(@DestRowFallback, "BookURL")
    ELSE
    SET @Destination     = "Kyoto"
    SET @Country         = "Japan"
    SET @Region          = "Asia"
    SET @Nights          = "6"
    SET @FromPrice       = "1,850"
    SET @Tagline         = "Immerse yourself in authentic tradition and peaceful gardens."
    SET @BookURL         = "https://wanderlustclub.com"
    ENDIF
