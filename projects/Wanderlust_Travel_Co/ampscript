  SET @staggeredImg1   = "https://images.unsplash.com/photo-1571984405176-5958bd9ac31d?auto=format&fit=crop&w=600&h=400&q=80"
  SET @staggeredImg2   = "https://images.unsplash.com/photo-1655719647300-5142977bfa79?auto=format&fit=crop&w=600&h=400&q=80"
  SET @discoverCardImg = "https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&h=750&q=80"
ELSEIF @travelStyle == "Adventure" THEN
  SET @heroBgImage     = "https://images.ampscriptacademy.com.au/uploads/adventure.png"
  SET @staggeredImg1   = "https://images.unsplash.com/photo-1586414840734-a570ab4ce4c4?auto=format&fit=crop&w=600&h=400&q=80"
  SET @staggeredImg2   = "https://images.unsplash.com/photo-1528543606781-2f6e6857f318?auto=format&fit=crop&w=600&h=400&q=80"
  SET @discoverCardImg = "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&h=750&q=80"
