  SET @staggeredImg2   = "https://images.unsplash.com/photo-1541336032412-2048a678540d?auto=format&fit=crop&w=600&h=400&q=80"
  SET @discoverCardImg = "https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&w=800&h=750&q=80"
ELSEIF @travelStyle == "Culture" THEN
