%%[
/* --- 1. Subscriber Data Attributes --- */
SET @SubscriberKey = AttributeValue("SubscriberKey")
SET @FirstName     = AttributeValue("FirstName")
SET @EmailAddress  = AttributeValue("EmailAddress")
SET @LastDest      = AttributeValue("LastDestination")
SET @RawTripDate   = AttributeValue("LastTripDate")
SET @TravelStyle   = AttributeValue("TravelStyle")
SET @LoyaltyTier   = AttributeValue("LoyaltyTier")
SET @PointsBalance = AttributeValue("PointsBalance")
SET @HomeCity      = AttributeValue("HomeCity")

/* Name Fallback */
IF NOT EMPTY(@FirstName) THEN
    SET @GreetingName = ProperCase(Trim(@FirstName))
ELSE
    SET @GreetingName = "Traveler"
ENDIF

/* Date Formatting */
IF NOT EMPTY(@RawTripDate) THEN
    SET @FormattedTripDate = FormatDate(@RawTripDate, "MMMM yyyy")
ELSE
    SET @FormattedTripDate = "your last trip"
ENDIF

/* Loyalty & Points */
IF NOT EMPTY(@PointsBalance) THEN
    SET @FormattedPoints = FormatNumber(@PointsBalance, "N0")
ELSE
    SET @FormattedPoints = "0"
ENDIF

IF EMPTY(@LoyaltyTier) THEN
    SET @LoyaltyTier = "Member"
ENDIF

IF EMPTY(@LastDest) THEN
    SET @LastDest = "your past journey"
ENDIF

