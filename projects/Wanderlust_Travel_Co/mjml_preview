<mjml>
  <mj-head>
    <mj-title>Wanderlust Club - Where Next?</mj-title>
    <mj-font name="Montserrat" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" />
    <mj-font name="Playfair Display" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Montserrat', Helvetica, Arial, sans-serif" color="#2b3338" />
      <mj-text font-size="13px" line-height="1.7" />
      <mj-section padding="0px" background-color="#ffffff" />
    </mj-attributes>
    <mj-style>
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&display=swap');
      @media only screen and (max-width: 480px) {
        .mobile-pad {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .mobile-center div {
          text-align: center !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body width="640px" background-color="#f5f2ee">

    <!-- TOP PRE-HEADER STRIP -->
    <mj-section background-color="#0d1b24" padding="10px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-size="10px" color="#c59b27" letter-spacing="2px" text-transform="uppercase">
          World Tourism Day Collection &bull; 9 Days Remaining<br>Valid Through Sept 27
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- BRAND BAR -->
    <mj-section background-color="#0d1b24" padding="18px 24px">
      <mj-column width="100%">
        <mj-text align="center" font-size="18px" font-weight="600" color="#f8f6f2" letter-spacing="4px" text-transform="uppercase" font-family="'Cormorant Garamond', Georgia, serif">
          &#x2B21; &nbsp;WANDERLUST CLUB
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 1. HERO SECTION WITH FLOATING CARD -->
    <mj-section background-url="./city.jpg" background-color="#0d1b24" background-size="cover" background-position="center center" padding="50px 24px 60px 24px">
      <mj-column width="100%" background-color="rgba(255, 255, 255, 0.95)" border-radius="2px" padding="36px 28px" border="1px solid #dfd7cc">
        
        <mj-text align="center" font-size="10px" font-weight="700" letter-spacing="3px" color="#c59b27" text-transform="uppercase" padding="0 0 10px 0">
          Exclusive Member Privilege &bull; Bronze
        </mj-text>

        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-size="30px" line-height="1.25" color="#0d1b24" padding="0 0 12px 0">
          Brisbane <span style="font-size: 20px; color: #c59b27; vertical-align: middle;">&#10230;</span> Tokyo
        </mj-text>

        <!-- Personalized Lead-In Copy -->
        <mj-text align="center" font-size="13px" color="#556066" font-style="italic" line-height="1.6" padding="0 24px 22px 24px">
          Specially curated for you in celebration of World Tourism Day.
        </mj-text>

        <mj-button background-color="#0d1b24" color="#ffffff" font-size="10px" font-weight="700" letter-spacing="2.5px" text-transform="uppercase" border-radius="0px" inner-padding="14px 28px" href="#">
          ENJOY 10% OFF SITEWIDE
        </mj-button>

        <mj-text align="center" font-size="10px" color="#8b9ba5" letter-spacing="0.5px" padding-top="10px" padding-bottom="0px">
          *Valid on all bookings completed by September 27.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- 2. STAGGERED EDITORIAL: THEN & NEXT HORIZON -->
    <mj-section background-color="#fcfbf9" padding="48px 24px 40px 24px">
      
      <!-- Left Column: The Memory -->
      <mj-column width="50%" padding="12px">
        <mj-image src="https://images.unsplash.com/photo-1541336032412-2048a678540d?auto=format&fit=crop&w=600&h=400&q=80" alt="Past Travel Reflections" border-radius="2px" padding="0 0 20px 0" fluid-on-mobile="true" />

        <mj-text font-size="9px" font-weight="700" letter-spacing="2.5px" color="#c59b27" text-transform="uppercase" padding="0 0 6px 0">
          The Memory &bull; April 2026
        </mj-text>

        <mj-text font-family="'Playfair Display', Georgia, serif" font-size="22px" font-weight="400" color="#0d1b24" padding="0 0 10px 0">
          Singapore
        </mj-text>

        <mj-text font-size="12px" color="#637077" line-height="1.8" padding="0">
          You uncovered the spirit of City travel during your time here. The quiet cadence and memories from this escape remain irreplaceable.
        </mj-text>
      </mj-column>

      <!-- Right Column: The Next Horizon (Natural progression) -->
      <mj-column width="50%" padding="12px">
        <mj-image src="https://plus.unsplash.com/premium_photo-1661914240950-b0124f20a5c1?auto=format&fit=crop&w=600&h=400&q=80" alt="Selected Destination Atmosphere" border-radius="2px" padding="0 0 20px 0" fluid-on-mobile="true" />

        <mj-text font-size="9px" font-weight="700" letter-spacing="2.5px" color="#c59b27" text-transform="uppercase" padding="0 0 6px 0">
          The Next Horizon
        </mj-text>

        <mj-text font-family="'Playfair Display', Georgia, serif" font-size="22px" font-weight="400" color="#0d1b24" padding="0 0 10px 0">
          Why Tokyo Next
        </mj-text>

        <mj-text font-size="12px" color="#637077" line-height="1.8" padding="0">
          For travelers drawn to City landscapes, Tokyo offers a richer, more secluded extension of what captured you in Singapore.
        </mj-text>
      </mj-column>

    </mj-section>

    <!-- 3. BESPOKE ITINERARY HEADER -->
    <mj-section background-color="#fcfbf9" padding="20px 20px 0px 20px">
      <mj-column width="100%">
        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-style="italic" font-size="34px" color="#0d1b24" padding="0">
          The Bespoke Itinerary
        </mj-text>
        <mj-text align="center" font-size="10px" color="#919ea6" letter-spacing="3px" text-transform="uppercase" padding="8px 0 0 0">
          Curated Package Details &bull; Private Collection
        </mj-text>
        <mj-divider width="30px" border-width="1px" border-color="#c59b27" padding="16px 0 24px 0" />
      </mj-column>
    </mj-section>

    <!-- 4. SIGNATURE ITINERARY CARD -->
    <mj-section background-color="#fcfbf9" padding="0 24px 50px 24px">
      <mj-column width="100%" background-color="#ffffff" border="1px solid #e7dfd5" padding="20px">
        <mj-section padding="0">
          
          <mj-column width="55%" padding="6px">
            <mj-image src="./city.gif" alt="Tokyo" padding="0" border-radius="1px" fluid-on-mobile="true" />
          </mj-column>

          <mj-column width="45%" padding="16px 8px 12px 16px" css-class="mobile-pad">
            <mj-text font-size="9px" font-weight="700" letter-spacing="2px" color="#c59b27" text-transform="uppercase" padding="0 0 6px 0">
              Asia &bull; PRIVATE RETREAT
            </mj-text>

            <mj-text font-family="'Playfair Display', Georgia, serif" font-size="20px" color="#0d1b24" padding="0 0 8px 0">
              Tokyo, Japan
            </mj-text>

            <mj-text font-size="12px" color="#637077" line-height="1.7" padding="0 0 12px 0">
              Neon nights and world-class food
            </mj-text>

            <!-- Price with Dynamic Member Tariff Strikethrough -->
            <mj-text font-size="11px" color="#919ea6" padding="0 0 2px 0">
              6 Nights &bull; <span style="text-decoration: line-through;">$1,899</span>
            </mj-text>

            <mj-text font-size="13px" font-weight="700" color="#0d1b24" letter-spacing="0.5px" padding="0 0 18px 0">
              Member Rate: $1,709
            </mj-text>

            <mj-button href="#" background-color="#0d1b24" color="#ffffff" font-size="10px" font-weight="700" letter-spacing="2px" border-radius="0px" inner-padding="12px 20px" align="left" css-class="mobile-center" padding="0">
              EXPLORE ITINERARY
            </mj-button>
          </mj-column>

        </mj-section>
      </mj-column>
    </mj-section>

    <!-- 5. TIER PRIVILEGE STRIP -->
    <mj-section background-color="#f2ede4" padding="36px 28px">
      <mj-column width="100%">
        <mj-text align="center" font-size="9px" font-weight="700" color="#7d6a45" letter-spacing="3px" text-transform="uppercase" padding="0 0 8px 0">
          TIER PRIVILEGE
        </mj-text>

        <mj-text align="center" font-family="'Playfair Display', Georgia, serif" font-size="20px" color="#0d1b24" padding="0 0 8px 0">
          Bronze Member &bull; 3,100 Balance
        </mj-text>

        <mj-text align="center" font-size="12px" color="#6f6b61" line-height="1.6" padding="0 24px">
          Apply your club points during checkout toward complimentary private transfers and suite upgrades in Tokyo.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- 6. FOOTER -->
        <mj-section background-color="#0B1C25" padding="0">
            <mj-column padding="0">
                <!-- Large Brand Block -->
                <mj-text align="center" color="#F4F0E6" font-family="'Cormorant Garamond', Georgia, serif" font-size="48px" font-weight="700" letter-spacing="2px" line-height="68px" padding="28px 10px 0">
                    WANDERLUST
                </mj-text>
                <mj-text align="center" color="#C8952E" font-family="Arial, Helvetica, sans-serif" font-size="11px" font-weight="600" letter-spacing="3px" line-height="18px" padding="0 20px 12px">
                    TRAVEL CO.
                </mj-text>
                <mj-text align="center" color="#D6DEE1" font-family="Arial, Helvetica, sans-serif" font-size="12px" line-height="18px" padding="0 35px 28px">
                    CURATED EXPERIENCES
                    <span style="color:#536A75;">&nbsp;&nbsp;FOR&nbsp;&nbsp;</span>
                    THOSE WHO TRAVEL DIFFERENTLY
                </mj-text>
                <mj-social mode="horizontal" align="center" icon-size="20px" icon-padding="8px" padding="0 0 24px">
                    <mj-social-element name="facebook" href="#" background-color="#172D38" />
                    <mj-social-element name="instagram" href="#" background-color="#172D38" />
                    <mj-social-element name="twitter" href="#" background-color="#172D38" />
                </mj-social>
                <mj-divider border-color="#C8952E" border-width="1px" width="92%" padding="0" />
                <mj-text align="center" color="#8297A1" font-family="Arial, Helvetica, sans-serif" font-size="9px" letter-spacing="1px" line-height="16px" padding="15px 20px 10px">
                    © WANDERLUST CLUB. 
                    ALL RIGHTS RESERVED
                </mj-text>
                <mj-text align="center" color="#7D98A8" font-family="Arial, Helvetica, sans-serif" font-size="10px" line-height="16px" padding="0 20px 18px">
                    <a href="#" style="color:#C8952E; text-decoration:none;">
                        Unsubscribe
                    </a>
                    &nbsp;&nbsp;•&nbsp;&nbsp;
                    <a href="#" style="color:#C8952E; text-decoration:none;">
                        Preferences
                    </a>
                </mj-text>
                <!-- Bottom Gold Accent -->
                <mj-section background-color="#C8952E" padding="0">
                    <mj-column padding="0">
                        <mj-text align="center" color="#0B1C25" font-family="Arial, Helvetica, sans-serif" font-size="8px" font-weight="600" letter-spacing="2px" padding="7px 10px">
                            TRAVEL WELL • TRAVEL DIFFERENTLY
                        </mj-text>
                    </mj-column>
                </mj-section>
            </mj-column>
        </mj-section>
  </mj-body>
</mjml>